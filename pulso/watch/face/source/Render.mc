import Toybox.Graphics;
import Toybox.Lang;
import Toybox.Math;
import Toybox.System;
import Toybox.Time;
import Toybox.Time.Gregorian;
import Toybox.WatchUi;

//! Colours. The FR255 MIP panel shows 64 colours (2 bits per channel: 00/55/AA/FF), so every
//! constant here is an exact palette entry; gradients are produced by ordered dithering.
module Pal {
    const WHITE = 0xFFFFFF;
    const GREY = 0xAAAAAA;
    const DGREY = 0x555555;
    const MSG = 0xFFFFAA;
    const GOOD = 0x55FF55;
    const WARN = 0xFFAA00;
    const BAD = 0xFF5555;
    const INFO = 0x55AAFF;
    const SLEEP = 0xAA55FF;

    //! calm -> tense, 9 steps
    const HEAT = [0x0055FF, 0x00AAFF, 0x00FFFF, 0x00FFAA, 0x55FF55, 0xAAFF00, 0xFFFF00, 0xFFAA00, 0xFF0000] as Array<Number>;
    //! 4x4 Bayer threshold matrix (0..15)
    const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5] as Array<Number>;

    //! central activation -9..9 (z * 3)
    function heatTr(v as Number) as Number {
        var i = ((v + 9) * 8 + 9) / 18;
        return HEAT[i < 0 ? 0 : (i > 8 ? 8 : i)];
    }

    //! Garmin stress 0..100
    function heatStress(s as Number) as Number {
        var i = (s * 8 + 50) / 100;
        return HEAT[i < 0 ? 0 : (i > 8 ? 8 : i)];
    }

    function heatZ(z as Float) as Number {
        return heatTr(Math.round(z * 3).toNumber());
    }
}

//! Draws the whole face (except the seconds) into a Dc, normally the off-screen buffer.
//! Coordinates are designed for 260x260 and scaled by width/260; the bitmap fonts come from
//! resources (generated by tools/gen_assets.py), so another resolution needs its own font set.
class Painter {
    // vertical layout at 260 px (top of each row)
    private const Y_DATE = 15;
    private const Y_TIME = 29;
    private const Y_AGORA = 79;
    private const Y_GAUGE = 102;
    private const Y_GRID1 = 110;
    private const Y_GRID2 = 128;
    private const Y_MEET = 148;
    private const Y_PEAK = 166;
    private const Y_MSG = 184;
    private const Y_STATUS = 221;
    private const GAUGE_W = 140;
    private const GAUGE_H = 4;
    private const ICON_W = 11;

    private const EXTRA = "ÁÀÂÃÉÊÍÓÔÕÚÜÇáàâãéêíóôõúüç°·•…–’“”";

    // public: the seconds slot computed by the last draw (used by onPartialUpdate)
    var secX as Number = 0;
    var secY as Number = 0;
    var secW as Number = 0;
    var secH as Number = 0;

    private var _cx as Number;
    private var _cy as Number;
    private var _s as Float;

    private var _fTime as Graphics.FontType;
    private var _fMid as Graphics.FontType;
    private var _fSmall as Graphics.FontType;
    private var _fTiny as Graphics.FontType;
    private var _fIcons as Graphics.FontType;
    private var _gauge as Graphics.BufferedBitmap? = null;

    private var _wd as String;
    private var _mo as String;
    private var _lAtiv as String;
    private var _lStress as String;
    private var _lGarmin as String;
    private var _lPeak1 as String;
    private var _lPeakN as String;
    private var _lNoPeaks as String;
    private var _lAgenda as String;
    private var _lHint as String;
    private var _sOk as String;
    private var _sNoPhone as String;
    private var _sToken as String;
    private var _sConfig as String;
    private var _sTimeout as String;
    private var _sErr as String;
    private var _sPaused as String;
    private var _sWait as String;
    private var _sNow as String;

    function initialize(w as Number, h as Number) {
        _cx = w / 2;
        _cy = h / 2;
        _s = w / 260.0;
        _fTime = WatchUi.loadResource(Rez.Fonts.FontTime) as WatchUi.FontResource;
        _fMid = WatchUi.loadResource(Rez.Fonts.FontMid) as WatchUi.FontResource;
        _fSmall = WatchUi.loadResource(Rez.Fonts.FontSmall) as WatchUi.FontResource;
        _fTiny = WatchUi.loadResource(Rez.Fonts.FontTiny) as WatchUi.FontResource;
        _fIcons = WatchUi.loadResource(Rez.Fonts.FontIcons) as WatchUi.FontResource;
        _wd = str(Rez.Strings.Weekdays);
        _mo = str(Rez.Strings.Months);
        _lAtiv = str(Rez.Strings.LblActivation);
        _lStress = str(Rez.Strings.LblStress);
        _lGarmin = str(Rez.Strings.LblGarmin);
        _lPeak1 = str(Rez.Strings.LblPeak1);
        _lPeakN = str(Rez.Strings.LblPeakN);
        _lNoPeaks = str(Rez.Strings.LblNoPeaks);
        _lAgenda = str(Rez.Strings.LblAgenda);
        _lHint = str(Rez.Strings.HintConfigure);
        _sOk = str(Rez.Strings.StOk);
        _sNoPhone = str(Rez.Strings.StNoPhone);
        _sToken = str(Rez.Strings.StToken);
        _sConfig = str(Rez.Strings.StConfig);
        _sTimeout = str(Rez.Strings.StTimeout);
        _sErr = str(Rez.Strings.StError);
        _sPaused = str(Rez.Strings.StPaused);
        _sWait = str(Rez.Strings.StWait);
        _sNow = str(Rez.Strings.AgeNow);
        _gauge = makeGauge();
    }

    private function str(id as ResourceId) as String {
        return WatchUi.loadResource(id) as String;
    }

    private function y(v as Number) as Number {
        return (v * _s).toNumber();
    }

    //! Pre-render the calm->tense gradient once, Bayer-dithered between neighbouring palette steps.
    private function makeGauge() as Graphics.BufferedBitmap? {
        if (!(Graphics has :createBufferedBitmap)) {
            return null;
        }
        var bmp = null;
        try {
            var ref = Graphics.createBufferedBitmap({:width => GAUGE_W, :height => GAUGE_H});
            bmp = ref.get() as Graphics.BufferedBitmap?;
        } catch (e) {
            return null;
        }
        if (bmp == null) {
            return null;
        }
        var dc = bmp.getDc();
        var last = -1;
        for (var x = 0; x < GAUGE_W; x++) {
            var f = x * 8.0 / (GAUGE_W - 1);
            var lo = f.toNumber();
            var hi = lo < 8 ? lo + 1 : 8;
            var frac = ((f - lo) * 16).toNumber();
            for (var yy = 0; yy < GAUGE_H; yy++) {
                var c = frac > Pal.BAYER[(yy % 4) * 4 + (x % 4)] ? Pal.HEAT[hi] : Pal.HEAT[lo];
                if (c != last) {
                    dc.setColor(c, c);
                    last = c;
                }
                dc.drawPoint(x, yy);
            }
        }
        return bmp;
    }

    // ---- entry point ------------------------------------------------------------------------------

    function draw(dc as Graphics.Dc, m as Model, now as Number, ct as System.ClockTime) as Void {
        dc.setColor(Graphics.COLOR_BLACK, Graphics.COLOR_BLACK);
        dc.clear();
        if (dc has :setAntiAlias) {
            dc.setAntiAlias(true);
        }
        var tz = ct.timeZoneOffset;
        var configured = Cfg.configured();
        // central values that are not "now" (sleep, HRV, peaks, insight) expire after 36 h
        var f = m.faceUsable(now) ? m.face : null;
        drawRing(dc, m, now, tz);
        drawDate(dc);
        drawTime(dc, ct);
        var central = drawAgora(dc, m, now);
        drawGrid(dc, m, f, central);
        drawMeeting(dc, m, now, ct);
        drawPeak(dc, m, f, now, tz);
        drawMsg(dc, f, configured);
        drawStatus(dc, m, now, configured);
    }

    //! Seconds next to the time (low cost: one fill + one glyph pair inside a tight clip).
    function drawSeconds(dc as Graphics.Dc, sec as Number) as Void {
        dc.setColor(Graphics.COLOR_BLACK, Graphics.COLOR_BLACK);
        dc.fillRectangle(secX, secY, secW, secH);
        dc.setColor(Pal.GREY, Graphics.COLOR_TRANSPARENT);
        dc.drawText(secX, secY, _fSmall, sec.format("%02d"), Graphics.TEXT_JUSTIFY_LEFT);
    }

    // ---- ring: last 12 h at their clock positions ------------------------------------------------

    private function clockDeg(t as Number, tz as Number) as Float {
        var local = (t + tz) % 43200;
        if (local < 0) {
            local += 43200;
        }
        return local * 360.0 / 43200.0;
    }

    //! drawArc angles: 0 = 3 o'clock, counter-clockwise; clock angles: 0 = 12 o'clock, clockwise.
    private function arcDeg(clock as Float) as Number {
        var d = (90.0 - clock).toNumber() % 360;
        return d < 0 ? d + 360 : d;
    }

    private function drawRing(dc as Graphics.Dc, m as Model, now as Number, tz as Number) as Void {
        var r = _cx - 5;
        if (m.ringMode != Lim.RING_NONE) {
            // Nothing older than 12 h: on a 12-h dial it would land just behind the "now" tick and read
            // as the last hours. The empty arc between the newest segment and the tick is the data's age.
            var oldest = now - 43200 + 600;
            for (var i = 0; i < 12; i++) {
                var t0 = m.ringT0 + i * 3600;
                var t1 = t0 + 3600;
                if (t0 < oldest) {
                    t0 = oldest;
                }
                if (t1 > now) {
                    t1 = now;
                }
                // under 10 min the 1.5-degree insets leave a1 <= a0 and drawArc would sweep the whole circle
                if (t1 - t0 < 600) {
                    continue;
                }
                var a0 = clockDeg(t0, tz) + 1.5;
                var a1 = a0 + (t1 - t0) * 0.1 / 12.0 - 3.0;   // 3600 s = 30 deg
                var v = m.ring[i];
                if (v instanceof Number) {
                    dc.setPenWidth(8);
                    var c = m.ringMode == Lim.RING_CENTRAL ? Pal.heatTr(v) : Pal.heatStress(v);
                    dc.setColor(c, Graphics.COLOR_TRANSPARENT);
                    dc.drawArc(_cx, _cy, r, Graphics.ARC_CLOCKWISE, arcDeg(a0), arcDeg(a1));
                } else {
                    dc.setPenWidth(2);
                    dc.setColor(Pal.DGREY, Graphics.COLOR_TRANSPARENT);
                    dc.drawArc(_cx, _cy, r + 2, Graphics.ARC_CLOCKWISE, arcDeg(a0), arcDeg(a1));
                }
            }
        } else {
            dc.setPenWidth(1);
            dc.setColor(Pal.DGREY, Graphics.COLOR_TRANSPARENT);
            dc.drawCircle(_cx, _cy, r + 3);
        }
        // "now" tick
        var a = Math.toRadians(clockDeg(now, tz));
        var sn = Math.sin(a);
        var cs = Math.cos(a);
        dc.setPenWidth(3);
        dc.setColor(Pal.WHITE, Graphics.COLOR_TRANSPARENT);
        dc.drawLine(_cx + (r - 9) * sn, _cy - (r - 9) * cs, _cx + (r + 4) * sn, _cy - (r + 4) * cs);
        dc.setPenWidth(1);
    }

    // ---- date, time ---------------------------------------------------------------------------------

    private function drawDate(dc as Graphics.Dc) as Void {
        var info = Gregorian.info(Time.now(), Time.FORMAT_SHORT);
        var dow = (info.day_of_week as Number) - 1;
        var mon = (info.month as Number) - 1;
        var s = _wd.substring(dow * 4, dow * 4 + 3) + " " + info.day.toString() + " " + _mo.substring(mon * 4, mon * 4 + 3);
        dc.setColor(Pal.GREY, Graphics.COLOR_TRANSPARENT);
        dc.drawText(_cx, y(Y_DATE), _fTiny, s, Graphics.TEXT_JUSTIFY_CENTER);
    }

    private function drawTime(dc as Graphics.Dc, ct as System.ClockTime) as Void {
        var hour = ct.hour;
        var hs;
        if (System.getDeviceSettings().is24Hour) {
            hs = hour.format("%02d");
        } else {
            hour = hour % 12;
            hs = (hour == 0 ? 12 : hour).toString();
        }
        var s = hs + ":" + ct.min.format("%02d");
        var ty = y(Y_TIME);
        dc.setColor(Pal.WHITE, Graphics.COLOR_TRANSPARENT);
        dc.drawText(_cx, ty, _fTime, s, Graphics.TEXT_JUSTIFY_CENTER);
        var tw = dc.getTextWidthInPixels(s, _fTime);
        secX = _cx + tw / 2 + 3;
        secY = ty + Graphics.getFontAscent(_fTime) - Graphics.getFontAscent(_fSmall);
        secW = dc.getTextWidthInPixels("00", _fSmall) + 2;
        secH = dc.getFontHeight(_fSmall);
    }

    // ---- "agora": central activation (z) or Garmin stress, plus the dithered gauge ----------------

    //! Returns true when the central's activation is shown (fresh face state).
    private function drawAgora(dc as Graphics.Dc, m as Model, now as Number) as Boolean {
        var az = m.az();
        var central = m.faceFresh(now) && az != null;
        var label = _lAtiv;
        var val = "--";
        var col = Pal.GREY;
        var suffix = "";
        var extra = "";
        var frac = -1.0;   // gauge marker position 0..1, < 0 = no marker
        if (central) {
            var z = az as Float;
            val = Fmt.signed1(z);
            col = Pal.heatZ(z);
            suffix = "z";
            var ahr = m.ahr();
            if (ahr != null) {
                extra = (ahr >= 0 ? "+" : "") + ahr.toString() + "bpm";
            }
            frac = (z + 3.0) / 6.0;
            frac = frac < 0.0 ? 0.0 : frac;
        } else {
            var s = m.stressNow();
            if (s != null) {
                label = _lStress;
                val = s.toString();
                col = Pal.heatStress(s);
                extra = _lGarmin;
                frac = s / 100.0;
            }
        }
        var ya = y(Y_AGORA);
        var aMid = Graphics.getFontAscent(_fMid);
        var wl = dc.getTextWidthInPixels(label, _fTiny);
        var wv = dc.getTextWidthInPixels(val, _fMid);
        var ws = suffix.length() > 0 ? dc.getTextWidthInPixels(suffix, _fSmall) + 1 : 0;
        var we = extra.length() > 0 ? dc.getTextWidthInPixels(extra, _fSmall) + 8 : 0;
        var x = _cx - (wl + 4 + wv + ws + we) / 2;
        dc.setColor(Pal.GREY, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, ya + aMid - Graphics.getFontAscent(_fTiny), _fTiny, label, Graphics.TEXT_JUSTIFY_LEFT);
        x += wl + 4;
        dc.setColor(col, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, ya, _fMid, val, Graphics.TEXT_JUSTIFY_LEFT);
        x += wv;
        var ySmall = ya + aMid - Graphics.getFontAscent(_fSmall);
        if (ws > 0) {
            dc.drawText(x + 1, ySmall, _fSmall, suffix, Graphics.TEXT_JUSTIFY_LEFT);
            x += ws;
        }
        if (we > 0) {
            dc.setColor(central ? Pal.WHITE : Pal.GREY, Graphics.COLOR_TRANSPARENT);
            dc.drawText(x + 8, ySmall, _fSmall, extra, Graphics.TEXT_JUSTIFY_LEFT);
        }

        // gauge
        var gx = _cx - GAUGE_W / 2;
        var gy = y(Y_GAUGE);
        var g = _gauge;
        if (g != null) {
            dc.drawBitmap(gx, gy, g);
        } else {
            var seg = GAUGE_W / 9;
            for (var i = 0; i < 9; i++) {
                dc.setColor(Pal.HEAT[i], Pal.HEAT[i]);
                dc.fillRectangle(gx + i * seg, gy, seg, GAUGE_H);
            }
        }
        if (frac >= 0.0) {
            if (frac > 1.0) {
                frac = 1.0;
            }
            var mx = gx + (frac * (GAUGE_W - 1)).toNumber();
            dc.setColor(Graphics.COLOR_BLACK, Graphics.COLOR_BLACK);
            dc.fillRectangle(mx - 2, gy - 2, 5, GAUGE_H + 4);
            dc.setColor(Pal.WHITE, Pal.WHITE);
            dc.fillRectangle(mx - 1, gy - 2, 3, GAUGE_H + 4);
        }
        return central;
    }

    // ---- 2 x 4 grid of icon + value cells -----------------------------------------------------------

    private function cell(dc as Graphics.Dc, xc as Number, yy as Number, icon as String, icol as Number,
                          val as String, vcol as Number) as Void {
        var wv = dc.getTextWidthInPixels(val, _fSmall);
        var x = xc - (ICON_W + 2 + wv) / 2;
        dc.setColor(icol, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy + 3, _fIcons, icon, Graphics.TEXT_JUSTIFY_LEFT);
        dc.setColor(vcol, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x + ICON_W + 2, yy, _fSmall, val, Graphics.TEXT_JUSTIFY_LEFT);
    }

    private function drawGrid(dc as Graphics.Dc, m as Model, f as Dictionary?, central as Boolean) as Void {
        var dx = (26 * _s).toNumber();
        var x0 = _cx - 3 * dx;
        var x1 = _cx - dx;
        var x2 = _cx + dx;
        var x3 = _cx + 3 * dx;
        var y1 = y(Y_GRID1);
        var y2 = y(Y_GRID2);

        var hr = m.heartRate();
        cell(dc, x0, y1, "h", Pal.BAD, Fmt.n(hr), Pal.WHITE);
        var bb = m.bodyBattery();
        cell(dc, x1, y1, "b", bb == null ? Pal.GREY : (bb >= 60 ? Pal.GOOD : (bb >= 30 ? 0xFFFF00 : Pal.BAD)), Fmt.n(bb), Pal.WHITE);
        cell(dc, x2, y1, "r", Pal.INFO, Fmt.n(m.respiration()), Pal.WHITE);
        var rec = m.recoveryMin();
        cell(dc, x3, y1, "c", (rec != null && rec > 24 * 60) ? Pal.WARN : Pal.GREY, rec == null ? "--" : Fmt.recovery(rec), Pal.WHITE);

        var hrv = J.num(f, "hrv");
        var hrvs = J.str(f, "hrvs");
        var hcol = Pal.GREY;
        if (hrvs != null) {
            if (hrvs.equals("below")) {
                hcol = Pal.WARN;
            } else if (hrvs.equals("normal")) {
                hcol = Pal.GOOD;
            } else if (hrvs.equals("above")) {
                hcol = Pal.INFO;
            }
        }
        cell(dc, x0, y2, "v", hcol, Fmt.n(hrv), Pal.WHITE);
        var slp = J.num(f, "slp");
        cell(dc, x1, y2, "s", Pal.SLEEP, slp == null ? "--" : Fmt.hm(slp), Pal.WHITE);
        var sd = J.num(f, "sd");
        var dcol = Pal.GREY;
        var dval = "--";
        if (sd != null) {
            dcol = sd <= 0 ? Pal.GOOD : (sd <= 60 ? 0xFFFF00 : (sd <= 120 ? Pal.WARN : Pal.BAD));
            dval = sd <= 0 ? "0" : "-" + Fmt.dur(sd);
        }
        cell(dc, x2, y2, "d", dcol, dval, Pal.WHITE);
        if (central) {
            // central activation is in the "agora" row: keep Garmin's own number visible for comparison
            var s = m.stressNow();
            cell(dc, x3, y2, "g", s == null ? Pal.GREY : Pal.heatStress(s), Fmt.n(s), Pal.WHITE);
        } else {
            var ep = J.num(f, "ep");
            cell(dc, x3, y2, "p", ep == null ? Pal.GREY : (ep > 0 ? Pal.WARN : Pal.GOOD), Fmt.n(ep), Pal.WHITE);
        }
    }

    // ---- next meeting --------------------------------------------------------------------------------

    private function drawMeeting(dc as Graphics.Dc, m as Model, now as Number, ct as System.ClockTime) as Void {
        var nm = (m.faceT > 0 && now - m.faceT < Lim.RING_MAX_AGE_S) ? J.dict(m.face, "nm") : null;
        var tStr = null;
        var title = "";
        var risk = null;
        if (nm != null) {
            tStr = J.str(nm, "t");
            var ti = J.str(nm, "ti");
            title = ti != null ? ti : "";
            risk = J.num(nm, "r");
            var mins = Fmt.minutesUntil(tStr, ct);
            if (mins != null && mins > 12 * 60) {
                nm = null;   // "15:00" already passed (wrapped to tomorrow): the face state is behind
            }
        }
        if (nm == null) {
            tStr = m.cCal;
            title = _lAgenda;
            risk = null;
            if (tStr == null) {
                return;
            }
        }
        var tm = tStr != null ? tStr : "";
        var yy = y(Y_MEET);
        var font = fits(title) ? _fSmall : Graphics.FONT_XTINY;
        var tfont = fits(tm) ? _fSmall : Graphics.FONT_XTINY;   // complication time is locale-formatted
        var wt = dc.getTextWidthInPixels(tm + " ", tfont);
        var wd = risk != null ? 3 * ICON_W + 4 : 0;
        var maxTitle = (200 * _s).toNumber() - ICON_W - 3 - wt - wd;
        title = ellipsize(dc, title, font, maxTitle);
        var wti = dc.getTextWidthInPixels(title, font);
        var x = _cx - (ICON_W + 3 + wt + wti + wd) / 2;
        dc.setColor(Pal.INFO, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy + 3, _fIcons, "k", Graphics.TEXT_JUSTIFY_LEFT);
        x += ICON_W + 3;
        var mins = Fmt.minutesUntil(tStr, ct);
        dc.setColor((mins != null && mins <= 15) ? Pal.WARN : Pal.WHITE, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy, tfont, tm, Graphics.TEXT_JUSTIFY_LEFT);
        x += wt;
        dc.setColor(Pal.WHITE, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy, font, title, Graphics.TEXT_JUSTIFY_LEFT);
        x += wti + 4;
        if (risk != null) {
            var rc = [Pal.GOOD, 0xFFFF00, Pal.WARN, 0xFF0000] as Array<Number>;
            var r = risk < 0 ? 0 : (risk > 3 ? 3 : risk);
            for (var i = 0; i < 3; i++) {
                dc.setColor(i < r ? rc[r] : Pal.DGREY, Graphics.COLOR_TRANSPARENT);
                dc.drawText(x, yy + 3, _fIcons, i < r ? "o" : "O", Graphics.TEXT_JUSTIFY_LEFT);
                x += ICON_W;
            }
        }
    }

    // ---- last stress peak of the day -----------------------------------------------------------------

    //! Episodes are "today" on the central: only shown when face.t is on today's local date.
    private function drawPeak(dc as Graphics.Dc, m as Model, f as Dictionary?, now as Number, tz as Number) as Void {
        if (f == null || (m.faceT + tz) / 86400 != (now + tz) / 86400) {
            return;
        }
        var ep = J.num(f, "ep");
        if (ep == null) {
            return;
        }
        var txt;
        if (ep <= 0) {
            txt = _lNoPeaks;
        } else {
            txt = ep.toString() + " " + (ep == 1 ? _lPeak1 : _lPeakN);
            var pk = J.str(f, "pk");
            if (pk != null) {
                txt += " · " + pk;
            }
            var pl = J.str(f, "pl");
            if (pl != null) {
                txt += " " + pl;
            }
        }
        var font = fits(txt) ? _fSmall : Graphics.FONT_XTINY;
        txt = ellipsize(dc, txt, font, (196 * _s).toNumber() - ICON_W - 2);
        var w = dc.getTextWidthInPixels(txt, font);
        var x = _cx - (ICON_W + 2 + w) / 2;
        var yy = y(Y_PEAK);
        dc.setColor(ep > 0 ? Pal.WARN : Pal.GOOD, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy + 3, _fIcons, "p", Graphics.TEXT_JUSTIFY_LEFT);
        dc.setColor(Pal.GREY, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x + ICON_W + 2, yy, font, txt, Graphics.TEXT_JUSTIFY_LEFT);
    }

    // ---- insight (2 lines, word-wrapped to the round screen) ----------------------------------------

    private function drawMsg(dc as Graphics.Dc, f as Dictionary?, configured as Boolean) as Void {
        var msg = J.str(f, "msg");
        var col = Pal.MSG;
        if (msg == null) {
            if (configured) {
                return;
            }
            msg = _lHint;
            col = Pal.GREY;
        }
        var font = fits(msg) ? _fSmall : Graphics.FONT_XTINY;
        var lines = wrap2(dc, msg, font, (184 * _s).toNumber(), (156 * _s).toNumber());
        var yy = y(Y_MSG);
        var step = dc.getFontHeight(_fSmall) - 1;
        dc.setColor(col, Graphics.COLOR_TRANSPARENT);
        for (var i = 0; i < lines.size(); i++) {
            dc.drawText(_cx, yy + i * step, font, lines[i], Graphics.TEXT_JUSTIFY_CENTER);
        }
    }

    // ---- staleness + link status ----------------------------------------------------------------------

    private function drawStatus(dc as Graphics.Dc, m as Model, now as Number, configured as Boolean) as Void {
        var age = "--";
        var acol = Pal.DGREY;
        if (m.faceT > 0) {
            var a = now - m.faceT;
            age = a < 90 ? _sNow : Fmt.age(a);
            acol = a < 900 ? Pal.GOOD : (a < 3600 ? Pal.WARN : Pal.BAD);
        }
        var link;
        var lcol;
        var code = m.stCode;
        if (!configured) {
            link = _sConfig;
            lcol = Pal.WARN;
        } else if (!Cfg.flag("uploadEnabled", true)) {
            link = _sPaused;
            lcol = Pal.GREY;
        } else if (code == null) {
            link = _sWait;
            lcol = Pal.GREY;
        } else if (code == 200) {
            link = _sOk;
            lcol = Pal.GOOD;
        } else if (code == K.CODE_NO_PHONE) {
            link = _sNoPhone;
            lcol = Pal.WARN;
        } else if (code == -2 || code == -300 || code == 408) {
            link = _sTimeout;
            lcol = Pal.WARN;
        } else if (code == 401 || code == 403) {
            link = _sToken;
            lcol = Pal.BAD;
        } else if (code == K.CODE_NO_CONFIG) {
            link = _sConfig;
            lcol = Pal.WARN;
        } else if (code == K.CODE_DISABLED) {
            link = _sPaused;
            lcol = Pal.GREY;
        } else {
            link = _sErr + " " + code.toString();
            lcol = Pal.BAD;
        }
        var pend = m.stPending > 0 ? " +" + m.stPending.toString() : "";
        var sep = " · ";
        var wa = dc.getTextWidthInPixels(age, _fSmall);
        var wsep = dc.getTextWidthInPixels(sep, _fSmall);
        var wl = dc.getTextWidthInPixels(link, _fSmall);
        var wp = pend.length() > 0 ? dc.getTextWidthInPixels(pend, _fSmall) : 0;
        var x = _cx - (wa + wsep + wl + wp) / 2;
        var yy = y(Y_STATUS);
        dc.setColor(acol, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy, _fSmall, age, Graphics.TEXT_JUSTIFY_LEFT);
        x += wa;
        dc.setColor(Pal.DGREY, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy, _fSmall, sep, Graphics.TEXT_JUSTIFY_LEFT);
        x += wsep;
        dc.setColor(lcol, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy, _fSmall, link, Graphics.TEXT_JUSTIFY_LEFT);
        x += wl;
        if (wp > 0) {
            dc.setColor(Pal.GREY, Graphics.COLOR_TRANSPARENT);
            dc.drawText(x, yy, _fSmall, pend, Graphics.TEXT_JUSTIFY_LEFT);
        }
    }

    // ---- text helpers ---------------------------------------------------------------------------------

    //! True when every character is in the bitmap font (ASCII + pt-BR accents); otherwise callers
    //! fall back to the system font, which covers any Unicode the central sends.
    private function fits(s as String) as Boolean {
        var cs = s.toCharArray();
        for (var i = 0; i < cs.size(); i++) {
            var n = cs[i].toNumber();
            if (n >= 32 && n <= 126) {
                continue;
            }
            if (EXTRA.find(cs[i].toString()) == null) {
                return false;
            }
        }
        return true;
    }

    private function ellipsize(dc as Graphics.Dc, s as String, font as Graphics.FontType, maxW as Number) as String {
        if (dc.getTextWidthInPixels(s, font) <= maxW) {
            return s;
        }
        var t = s;
        while (t.length() > 1) {
            var u = t.substring(0, t.length() - 1);
            t = u != null ? u : "";
            if (dc.getTextWidthInPixels(t + "…", font) <= maxW) {
                break;
            }
        }
        return t + "…";
    }

    //! Greedy word wrap into at most two lines of different widths; ellipsis when it does not fit.
    private function wrap2(dc as Graphics.Dc, s as String, font as Graphics.FontType, w1 as Number, w2 as Number) as Array<String> {
        var words = [] as Array<String>;
        var rest = s;
        while (rest.length() > 0) {
            var i = rest.find(" ");
            if (i == null) {
                words.add(rest);
                break;
            }
            if (i > 0) {
                var wd = rest.substring(0, i);
                if (wd != null) {
                    words.add(wd);
                }
            }
            var r = rest.substring(i + 1, rest.length());
            rest = r != null ? r : "";
        }
        var lines = [] as Array<String>;
        var cur = "";
        var k = 0;
        while (k < words.size() && lines.size() < 2) {
            var cand = cur.length() > 0 ? cur + " " + words[k] : words[k];
            var maxW = lines.size() == 0 ? w1 : w2;
            if (dc.getTextWidthInPixels(cand, font) <= maxW || cur.length() == 0) {
                cur = cand;
                k++;
            } else {
                lines.add(cur);
                cur = "";
            }
        }
        if (lines.size() < 2 && cur.length() > 0) {
            lines.add(cur);
            cur = "";
        }
        // a single over-long word can still overflow a line; the last line also absorbs what is left
        for (var li = 0; li < lines.size(); li++) {
            var maxW = li == 0 ? w1 : w2;
            var ln = lines[li];
            if (li == lines.size() - 1 && k < words.size()) {
                ln = ln + " " + words[k];
            }
            lines[li] = ellipsize(dc, ln, font, maxW);
        }
        return lines;
    }
}

//! pt-BR number formatting.
module Fmt {
    function n(v as Number?) as String {
        return v == null ? "--" : v.toString();
    }

    //! 1.44 -> "+1,4", -0.3 -> "-0,3" (decimal comma)
    function signed1(z as Float) as String {
        var t = (Math.round(z * 10).toNumber()).abs();
        return (z < -0.05 ? "-" : "+") + (t / 10).toString() + "," + (t % 10).toString();
    }

    //! 432 -> "7h12", 45 -> "45m"
    function hm(min as Number) as String {
        if (min < 60) {
            return min.toString() + "m";
        }
        return (min / 60).toString() + "h" + (min % 60).format("%02d");
    }

    //! 40 -> "40m", 80 -> "1h20", 120 -> "2h"
    function dur(min as Number) as String {
        if (min < 60) {
            return min.toString() + "m";
        }
        var r = min % 60;
        return (min / 60).toString() + "h" + (r == 0 ? "" : r.format("%02d"));
    }

    //! recovery minutes -> "18h" (rounded up) or "40m"
    function recovery(min as Number) as String {
        if (min <= 0) {
            return "0h";
        }
        return min < 60 ? min.toString() + "m" : ((min + 59) / 60).toString() + "h";
    }

    //! seconds -> "3m", "2h", "1d"
    function age(s as Number) as String {
        if (s < 3600) {
            return (s / 60).toString() + "m";
        }
        if (s < 86400) {
            return (s / 3600).toString() + "h";
        }
        return (s / 86400).toString() + "d";
    }

    //! Minutes from now until "HH:MM" (local), 0..1439; null when the string is not a time.
    function minutesUntil(hhmm as String?, ct as System.ClockTime) as Number? {
        if (hhmm == null || hhmm.length() != 5) {
            return null;
        }
        var hs = hhmm.substring(0, 2);
        var ms = hhmm.substring(3, 5);
        if (hs == null || ms == null) {
            return null;
        }
        var h = hs.toNumber();
        var mi = ms.toNumber();
        if (h == null || mi == null) {
            return null;
        }
        var d = h * 60 + mi - (ct.hour * 60 + ct.min);
        return d < 0 ? d + 1440 : d;
    }
}
