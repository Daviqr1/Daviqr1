project.manifest = manifest.xml

# Properties (setting defaults) live outside resources/ so a sideload build can swap them:
#   python3 tools/bake_config.py --url https://minha-central --token pulso_dev_...
# writes config/local/properties.xml + local.jungle (both gitignored); then build with
#   monkeyc -f "monkey.jungle;local.jungle" ...
# Garmin Connect only edits settings of apps installed from the Connect IQ Store, so a
# sideloaded face needs its URL/token baked in this way.
base.resourcePath = resources;config/default

# For the 218x218 Forerunner 255S: generate a font set with
#   python3 tools/gen_assets.py --scale 0.8385 --out resources-round-218x218
# keep only its fonts/ folder, and add fr255s/fr255sm to the manifest.
