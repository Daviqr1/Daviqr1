# domínio público com DNS apontando para esta máquina (ou use um túnel, ver docs/deploy.md)
PULSO_DOMAIN=pulso.seudominio.dev
PULSO_TZ=America/Sao_Paulo
# quem é você na agenda e nas transcrições (vira "EU" no tagger e nunca é pseudonimizado). Só o nome
# inteiro conta: inclua o seu nome completo como a agenda/transcrição o escreve. Um colega com o mesmo
# primeiro nome ("Davi Costa") continua virando Pessoa A, B…
PULSO_ME=eu,davi,gabi,davi becam

# Claude (relatórios e etiquetagem). Modelo padrão: claude-opus-5-5
ANTHROPIC_API_KEY=
# PULSO_REPORT_MODEL=claude-opus-5-5
# PULSO_TAGGER_MODEL=claude-opus-5-5

# MCP por HTTP
PULSO_MCP_TOKEN=

# Garmin Connect (biblioteca não oficial, sua conta). Só no primeiro login; depois ficam os tokens
# (em /data/garminconnect, no volume pulso-data). Com MFA, faça o 1º login interativo:
#   docker compose run --rm jobs pulso import garmin --days 30
GARMIN_EMAIL=
GARMIN_PASSWORD=
